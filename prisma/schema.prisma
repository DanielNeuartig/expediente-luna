// SCHEMA ACTUALIZADO

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoVisita {
  CONSULTA_GENERAL
  CONTROL_SUBSECUENTE
  PROCEDIMIENTO
}

enum Sexo {
  MACHO
  HEMBRA
  INDETERMINADO
}

enum Especie {
  PERRO
  GATO
  REPTIL
  ROEDOR
  AVE
}

model Propietario {
  id            Int          @id @default(autoincrement())
  nombre        String
  telefonos     Telefono[]
  mascotas      Mascota[]
  creadoEn      DateTime     @default(now())
  actualizadoEn DateTime     @updatedAt
}

model Telefono {
  id            Int          @id @default(autoincrement())
  numero        String
  esPrincipal   Boolean
  propietario   Propietario  @relation(fields: [propietarioId], references: [id])
  propietarioId Int
}

model Mascota {
  id              Int          @id @default(autoincrement())
  nombre          String
  especie         Especie
  raza            String?
  sexo            Sexo
  color           String?
  fechaNacimiento DateTime?
  senasPartic     String?
  notas           String?
  esterilizado    Boolean
  alergias        String?
  propietario     Propietario  @relation(fields: [propietarioId], references: [id])
  propietarioId   Int
  visitas         Visita[]
  creadoEn        DateTime     @default(now())
  actualizadoEn   DateTime     @updatedAt
}

model Visita {
  id               Int              @id @default(autoincrement())
  mascota          Mascota          @relation(fields: [mascotaId], references: [id])
  mascotaId        Int
  tipo             TipoVisita
  tipoDeProcedimiento String?
  reporteIngreso   String?
  reporteFinal     String?
  fecha            DateTime         @default(now())
  edadMascota      Int?
  peso             Float?
  temperatura      Float?
  historiaClinica  String?
  exploracionFisica String?
  diagnosticoPresuntivoActual String?
  pronostico       String?
  medicamentos     MedicamentoRecetado[]
  indicaciones     IndicacionMedica[]
  archivos         Archivo[]
  notasAdicionales String?
  actualizaciones  Actualizacion[]
  creadoPor        UsuarioSistema?  @relation("VisitasCreadas", fields: [creadoPorId], references: [id])
  creadoPorId      Int?
  cerrada          Boolean          @default(false)
  fechaCierre      DateTime?
  creadoEn         DateTime         @default(now())
  actualizadoEn    DateTime         @updatedAt
}

model MedicamentoRecetado {
  id              Int      @id @default(autoincrement())
  nombre          String
  dosis           String
  via             String
  veces           Int
  cada            Int
  iniciarEn       DateTime
  enReceta        Boolean
  motivoSuspension String?
  visita          Visita   @relation(fields: [visitaId], references: [id])
  visitaId        Int
  creadoEn        DateTime @default(now())
  aplicaciones    AplicacionMedicamento[]
}

model AplicacionMedicamento {
  id            Int              @id @default(autoincrement())
  medicamento   MedicamentoRecetado @relation(fields: [medicamentoId], references: [id])
  medicamentoId Int
  fecha         DateTime
  visita        Visita           @relation(fields: [visitaId], references: [id])
  visitaId      Int
  usuario       UsuarioSistema   @relation(fields: [usuarioId], references: [id])
  usuarioId     Int
  observaciones String?
}

model IndicacionMedica {
  id        Int    @id @default(autoincrement())
  texto     String
  visita    Visita @relation(fields: [visitaId], references: [id])
  visitaId  Int
}

model Archivo {
  id        Int      @id @default(autoincrement())
  url       String
  visita    Visita   @relation(fields: [visitaId], references: [id])
  visitaId  Int
  creadoEn  DateTime @default(now())
}

model Actualizacion {
  id        Int            @id @default(autoincrement())
  visita    Visita         @relation(fields: [visitaId], references: [id])
  visitaId  Int
  descripcion String
  fecha     DateTime       @default(now())
  usuario   UsuarioSistema @relation(fields: [usuarioId], references: [id])
  usuarioId Int
}

model UsuarioSistema {
  id               Int              @id @default(autoincrement())
  nombre           String
  correo           String           @unique
  contrasena       String
  creadoEn         DateTime         @default(now())
  ultimaConexion   DateTime?
  visitas          Visita[]         @relation("VisitasCreadas")
  actualizaciones  Actualizacion[]
}